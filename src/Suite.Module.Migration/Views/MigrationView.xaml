<UserControl x:Class="WindowsCareKit.Module.Migration.Views.MigrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WindowsCareKit.App.Controls;assembly=Suite.App.Abstractions"
             xmlns:mvvm="clr-namespace:WindowsCareKit.App.Mvvm;assembly=Suite.App.Abstractions">
    <!-- Restyled to the emerald evidence-row language (2026-07 UI rollout): Backup.* tokens, two-tier rows,
         a DRY-RUN badge on the capture (dry-run backup) section, and the SAME 3-color risk vocabulary as
         ConfirmGate/Backup for the legend + promise cards (emerald=portable/reversible, amber=needs another
         step, red=manual/cannot-restore — never green for anything that still needs the user).
         Presentation-only — no ViewModel/selection-logic change; Groups/Items keep their existing bindings. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <mvvm:PositiveToVisibleConverter x:Key="PositiveToVis" />
        <mvvm:NonEmptyToVisibleConverter x:Key="NonEmptyToVis" />

        <Style x:Key="MigrationCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Backup.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Backup.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="4" Opacity="0.16" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MigrationSectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Backup.Ink}" />
            <Setter Property="FontSize" Value="15.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="MigrationMeta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Backup.Faint}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="MigrationSecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Backup.Ink}" />
            <Setter Property="Background" Value="{DynamicResource Backup.CardHi}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Backup.LineStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,7.5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Backup.Faint}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{DynamicResource Opacity.Disabled.Button}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MigrationPrimaryButton" TargetType="Button" BasedOn="{StaticResource MigrationSecondaryButton}">
            <Setter Property="Foreground" Value="{DynamicResource Backup.EmInk}" />
            <Setter Property="Background" Value="{DynamicResource Backup.Primary.Background}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Backup.Primary.Border}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Backup.Primary.Hover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{DynamicResource Opacity.Disabled.Button}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MigrationApproveCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Backup.Ink}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="15" Height="15" CornerRadius="3"
                                    Background="{DynamicResource Backup.Card}"
                                    BorderBrush="{DynamicResource Backup.EmBorder}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check" Data="M3,7 L6,10 L12,4"
                                      Stroke="{DynamicResource Backup.EmInk}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Backup.Em}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Backup.Em}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{DynamicResource Opacity.Disabled.Button}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- App-row expand affordance (A4): a chrome-less, keyboard-accessible ToggleButton spans the complete
             non-checkbox header and exposes its checked state through the standard automation toggle pattern. -->
        <Style x:Key="MigrationAppRowToggle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Reused by the expanded part list (A4): flat rows, no nested cards. -->
        <Style x:Key="MigrationPartBadge" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Backup.CardHi}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Backup.LineStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="8,3" />
        </Style>

        <!-- Capture dry-run row: two-tier, monospace action line only (it IS a literal path/command). -->
        <DataTemplate x:Key="PlanRowTemplate">
            <Border Background="{DynamicResource Backup.Row.Background}" BorderBrush="{DynamicResource Backup.Line}"
                    BorderThickness="1" CornerRadius="8" Padding="11,9" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:RiskChip Grid.Column="0" Risk="{Binding Risk}" IsBlocked="{Binding IsSkipped}"
                                       Text="{Binding RiskText}"
                                       VerticalAlignment="Top" Margin="0,1,10,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Text}" Foreground="{DynamicResource Backup.Ink}"
                                   FontFamily="{DynamicResource Wck.Mono}"
                                   FontSize="12.5" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MigrationMeta}" Margin="0,3,0,0"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding Detail, Converter={StaticResource NonEmptyToVis}}" />
                        <TextBlock Text="{Binding Undo}" Style="{StaticResource MigrationMeta}"
                                   Visibility="{Binding Undo, Converter={StaticResource NonEmptyToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="24,14,24,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,2,0">
            <StackPanel MaxWidth="920" HorizontalAlignment="Center">
                <Border Background="{DynamicResource Backup.EmWash}" BorderBrush="{DynamicResource Backup.EmBorder}"
                        BorderThickness="1" CornerRadius="999" Padding="12,4" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding I18n[migration.eyebrow]}" Foreground="{DynamicResource Backup.Em}"
                               FontSize="10.5" FontWeight="Bold" />
                </Border>
                <TextBlock Text="{Binding I18n[migration.title]}" Foreground="{DynamicResource Backup.Ink}"
                           FontSize="24" FontWeight="SemiBold" Margin="0,8,0,0" />
                <TextBlock Text="{Binding I18n[migration.subtitle]}" Foreground="{DynamicResource Backup.Muted}"
                           FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!-- What we can carry: genuinely reversible/portable — emerald is honest here. -->
                    <Border Grid.Column="0" Background="{DynamicResource Backup.OkWash}" BorderBrush="{DynamicResource Backup.OkBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{Binding I18n[migration.promise.restore.title]}"
                                       Foreground="{DynamicResource Backup.OkFg}" FontWeight="Bold" FontSize="13.5" />
                            <TextBlock Text="{Binding I18n[migration.promise.restore.body]}"
                                       Foreground="{DynamicResource Backup.Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <!-- What needs your action: loud red — never softened. -->
                    <Border Grid.Column="2" Background="{DynamicResource Backup.Row.Danger}" BorderBrush="{DynamicResource Backup.DangerBorder}"
                            BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <TextBlock Text="{Binding I18n[migration.promise.manual.title]}"
                                       Foreground="{DynamicResource Backup.DangerStrong}" FontWeight="Bold" FontSize="13.5" />
                            <TextBlock Text="{Binding I18n[migration.promise.manual.body]}"
                                       Foreground="{DynamicResource Backup.Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource MigrationCard}" Margin="0,14,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding I18n[migration.scan.title]}" Style="{StaticResource MigrationSectionTitle}" />
                                <TextBlock Text="{Binding ProfileSummary}" Style="{StaticResource MigrationMeta}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource MigrationPrimaryButton}"
                                        Content="{Binding I18n[migration.scan.start]}"
                                        Command="{Binding StartScanCommand}" />
                                <Button Style="{StaticResource MigrationSecondaryButton}" Margin="8,0,0,0"
                                        Content="{Binding I18n[migration.scan.cancel]}"
                                        Command="{Binding CancelScanCommand}"
                                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{Binding I18n[migration.scan.running]}" Foreground="{DynamicResource Backup.Muted}"
                                   FontSize="12.5" Margin="0,12,0,0"
                                   Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding ScanError}" Foreground="{DynamicResource Backup.DangerStrong}"
                                   FontSize="12.5" FontWeight="SemiBold" Margin="0,10,0,0"
                                   Visibility="{Binding ScanError, Converter={StaticResource NonEmptyToVis}}" />
                        <ItemsControl ItemsSource="{Binding SourceRows}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Glyph}" Margin="0,0,8,0" FontSize="12.5" />
                                            <TextBlock Text="{Binding Text}" Foreground="{DynamicResource Backup.Muted}" FontSize="12.5" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MigrationMeta}" Margin="21,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding CeilingText}" Style="{StaticResource MigrationMeta}" Margin="0,12,0,0"
                                   Visibility="{Binding IsScanComplete, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <!-- Legend — the SAME 3-color risk vocabulary as ConfirmGate/Backup. -->
                <StackPanel Orientation="Horizontal" Margin="0,16,0,8">
                    <Border Background="{DynamicResource Backup.OkWash}" BorderBrush="{DynamicResource Backup.OkBorder}" BorderThickness="1"
                            CornerRadius="999" Padding="11,5" Margin="0,0,8,0">
                        <TextBlock Text="{Binding I18n[migration.legend.portable]}" Foreground="{DynamicResource Backup.OkFg}" FontSize="12" />
                    </Border>
                    <Border Background="{DynamicResource Backup.MedWash}" BorderBrush="{DynamicResource Backup.MedBorder}" BorderThickness="1"
                            CornerRadius="999" Padding="11,5" Margin="0,0,8,0">
                        <TextBlock Text="{Binding I18n[migration.legend.step]}" Foreground="{DynamicResource Backup.MedFg}" FontSize="12" />
                    </Border>
                    <Border Background="{DynamicResource Backup.Row.Danger}" BorderBrush="{DynamicResource Backup.DangerBorder}" BorderThickness="1"
                            CornerRadius="999" Padding="11,5">
                        <TextBlock Text="{Binding I18n[migration.legend.manual]}" Foreground="{DynamicResource Backup.DangerStrong}" FontSize="12" />
                    </Border>
                </StackPanel>

                <TextBlock Text="{Binding I18n[migration.groups.heading]}" Style="{StaticResource MigrationSectionTitle}"
                           FontSize="14" Margin="0,10,0,10" />
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MigrationCard}" Padding="0" Margin="0,0,0,12" ClipToBounds="True">
                                <Expander IsExpanded="True" BorderThickness="0" Background="Transparent">
                                    <Expander.Header>
                                        <Grid MinWidth="760" Margin="14,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0" IsThreeState="True" IsChecked="{Binding IsChecked}"
                                                      Style="{StaticResource MigrationApproveCheckBox}"
                                                      IsEnabled="{Binding DataContext.CanSelect, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      VerticalAlignment="Center" Margin="0,0,14,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Backup.Ink}" FontWeight="Bold" FontSize="14.5" />
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MigrationMeta}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{DynamicResource Backup.CardHi}" BorderBrush="{DynamicResource Backup.LineStrong}"
                                                    BorderThickness="1" CornerRadius="999" Padding="10,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding CountSummary}" Foreground="{DynamicResource Backup.Muted}" FontSize="11.5" />
                                            </Border>
                                        </Grid>
                                    </Expander.Header>
                                    <!-- A1/A2: one row per APP (not per file). Multi-part apps get an expander
                                         revealing a read-only part list; single-part apps (fallback candidates,
                                         single-item recipes) render identically but with no expand chip. -->
                                    <ItemsControl ItemsSource="{Binding Apps}" Margin="14,0,14,12">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Backup.Row.Background}" BorderBrush="{DynamicResource Backup.Line}"
                                                        BorderThickness="1" CornerRadius="8" Margin="0,0,0,6">
                                                    <StackPanel>
                                                        <Grid Margin="12,10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}"
                                                                      ToolTip="{Binding ForcedTooltip}"
                                                                      ToolTipService.ShowOnDisabled="True"
                                                                      VerticalAlignment="Top" Margin="0,2,12,0">
                                                                <CheckBox.Style>
                                                                    <Style TargetType="CheckBox" BasedOn="{StaticResource MigrationApproveCheckBox}">
                                                                        <Setter Property="IsEnabled" Value="True" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding DataContext.CanSelect, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                                                <Setter Property="IsEnabled" Value="False" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsForced}" Value="True">
                                                                                <Setter Property="IsEnabled" Value="False" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </CheckBox.Style>
                                                            </CheckBox>
                                                            <!-- The full non-checkbox header is one keyboard-accessible ToggleButton. Its
                                                                 expanded/collapsed glyph and automation name stay in sync with the row state. -->
                                                            <ToggleButton Grid.Column="1" Style="{StaticResource MigrationAppRowToggle}"
                                                                          IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                                          IsEnabled="{Binding HasMultipleParts}"
                                                                          AutomationProperties.Name="{Binding Title}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <StackPanel Grid.Column="0">
                                                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Backup.Ink}"
                                                                                   FontWeight="SemiBold" FontSize="13" />
                                                                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource Backup.Muted}"
                                                                                   FontSize="12" TextWrapping="Wrap" Margin="0,3,10,0" />
                                                                        <StackPanel Orientation="Horizontal" Margin="0,3,10,0">
                                                                            <TextBlock Text="{Binding MetaLine}" Style="{StaticResource MigrationMeta}"
                                                                                       Visibility="{Binding MetaLine, Converter={StaticResource NonEmptyToVis}}" />
                                                                            <Border Background="{DynamicResource Backup.CardHi}" BorderBrush="{DynamicResource Backup.LineStrong}"
                                                                                    BorderThickness="1" CornerRadius="999" Padding="7,2" Margin="8,0,0,0"
                                                                                    Visibility="{Binding SecretExcludedText, Converter={StaticResource NonEmptyToVis}}">
                                                                                <TextBlock Text="{Binding SecretExcludedText}" Foreground="{DynamicResource Backup.Faint}" FontSize="11" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding DataContext.I18n[migration.item.forced], RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                   Foreground="{DynamicResource Backup.DangerStrong}" FontWeight="Bold" FontSize="11" Margin="0,4,0,0"
                                                                                   Visibility="{Binding IsForced, Converter={StaticResource BoolToVis}}" />
                                                                    </StackPanel>
                                                                    <Border Grid.Column="1" Style="{StaticResource MigrationPartBadge}"
                                                                            Padding="9,4" VerticalAlignment="Top" Margin="8,0,0,0">
                                                                        <TextBlock Text="{Binding BadgeText}" Foreground="{DynamicResource Backup.Ink}" FontWeight="Bold" FontSize="11" />
                                                                    </Border>
                                                                    <TextBlock Grid.Column="2" Foreground="{DynamicResource Backup.Faint}" FontSize="11"
                                                                               VerticalAlignment="Top" Margin="8,3,0,0">
                                                                        <Run Text="{Binding PartsSummary, Mode=OneWay}" />
                                                                        <Run Text=" " />
                                                                        <Run Text="{Binding ExpansionGlyph, Mode=OneWay}" />
                                                                    </TextBlock>
                                                                </Grid>
                                                            </ToggleButton>
                                                        </Grid>
                                                        <!-- A4: expanded, read-only part list — flat inset panel, no nested cards. Reserves an
                                                             empty 24px checkbox-slot column (Phase 2 fills it; layout must not shift then). -->
                                                        <Border Background="{DynamicResource Backup.PathBg}" CornerRadius="6" Margin="10,0,10,10"
                                                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                                            <ItemsControl ItemsSource="{Binding Parts}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border BorderBrush="{DynamicResource Backup.Line}" BorderThickness="0,0,0,1" Padding="10,7">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="24" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                    <ColumnDefinition Width="Auto" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <Border Grid.Column="0" Width="24" />
                                                                                <StackPanel Grid.Column="1" Margin="8,0,10,0">
                                                                                    <TextBlock Text="{Binding PartLabel}" Foreground="{DynamicResource Backup.Ink}" FontSize="12.5" />
                                                                                    <StackPanel Orientation="Horizontal">
                                                                                        <TextBlock Text="{Binding Candidate.SourcePath}" Style="{StaticResource MigrationMeta}"
                                                                                                   FontFamily="{DynamicResource Wck.Mono}" TextWrapping="NoWrap" />
                                                                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource MigrationMeta}" Margin="8,0,0,0"
                                                                                                   Visibility="{Binding SizeText, Converter={StaticResource NonEmptyToVis}}" />
                                                                                    </StackPanel>
                                                                                    <TextBlock Text="{Binding WhatHappens}" Style="{StaticResource MigrationMeta}" Margin="0,2,0,0"
                                                                                               TextWrapping="Wrap"
                                                                                               Visibility="{Binding HasLockedNowReason, Converter={StaticResource BoolToVis}}" />
                                                                                </StackPanel>
                                                                                <Border Grid.Column="2" Style="{StaticResource MigrationPartBadge}" VerticalAlignment="Top">
                                                                                    <TextBlock Text="{Binding BadgeText}" Foreground="{DynamicResource Backup.Ink}" FontSize="10" FontWeight="Bold" />
                                                                                </Border>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource MigrationCard}" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding I18n[migration.preview.title]}" Style="{StaticResource MigrationSectionTitle}" />
                        <TextBlock Text="{Binding I18n[migration.preview.body]}" Style="{StaticResource MigrationMeta}" Margin="0,4,0,10" />
                        <ItemsControl ItemsSource="{Binding CommandPreview}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="{DynamicResource Wck.Mono}" FontSize="11.5"
                                               Foreground="{DynamicResource Code.Fg}" Background="{DynamicResource Code.Bg}" Padding="10,7"
                                               TextWrapping="Wrap" Margin="0,0,0,5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource MigrationCard}" Margin="0,14,0,0"
                        Visibility="{Binding HasManualTodo, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding I18n[migration.manual.title]}" Style="{StaticResource MigrationSectionTitle}" />
                        <TextBlock Text="{Binding I18n[migration.manual.body]}" Style="{StaticResource MigrationMeta}" Margin="0,4,0,10" />
                        <ItemsControl ItemsSource="{Binding ManualTodoDisplay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource Backup.Muted}" FontSize="12.5" Margin="0,3,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,20,0,2">
                    <TextBlock Text="{Binding I18n[migration.capture.title]}" Foreground="{DynamicResource Backup.Ink}"
                               FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource Backup.EmWash}" BorderBrush="{DynamicResource Backup.EmBorder}"
                            BorderThickness="1" CornerRadius="999" Padding="12,4" Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Backup.Em}" Margin="0,0,8,0" />
                            <TextBlock Foreground="{DynamicResource Backup.Em}" FontSize="10.5" FontWeight="Bold">
                                <Run Text="{Binding I18n[common.dryRun.badge], Mode=OneWay}" />
                                <Run Text="{Binding I18n[common.dryRun.caption], Mode=OneWay}"
                                     Foreground="{DynamicResource Backup.Muted}" FontSize="11" FontWeight="Normal" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <Border Style="{StaticResource MigrationCard}" Margin="0,10,0,20">
                    <StackPanel>
                        <TextBlock Text="{Binding I18n[migration.capture.destination]}" Style="{StaticResource MigrationMeta}" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" VerticalContentAlignment="Center" Padding="10,8"
                                     IsEnabled="{Binding CanEditDirectories}"
                                     Background="{DynamicResource Backup.Card}" Foreground="{DynamicResource Backup.Ink}"
                                     BorderBrush="{DynamicResource Backup.LineStrong}" BorderThickness="1"
                                     FontFamily="{DynamicResource Wck.Mono}" FontSize="12.5"
                                     Text="{Binding PackageDir, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Margin="9,0,0,0" Style="{StaticResource MigrationSecondaryButton}"
                                    IsEnabled="{Binding CanEditDirectories}"
                                    Content="{Binding I18n[migration.capture.chooseFolder]}" Click="ChoosePackageFolder_Click" />
                            <Button Grid.Column="2" Margin="9,0,0,0" Style="{StaticResource MigrationPrimaryButton}"
                                    Content="{Binding I18n[migration.capture.buildPlan]}" Command="{Binding BuildCapturePlanCommand}" />
                        </Grid>
                        <TextBlock Text="{Binding PackageWarning}" Foreground="{DynamicResource Backup.DangerStrong}"
                                   FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding PackageWarning, Converter={StaticResource NonEmptyToVis}}" />
                        <CheckBox IsChecked="{Binding IsPreviewApproved}" Margin="0,12,0,0"
                                  Style="{StaticResource MigrationApproveCheckBox}"
                                  Content="{Binding I18n[migration.capture.approve]}"
                                  Visibility="{Binding HasCapturePlan, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{Binding CaptureSummary}" Foreground="{DynamicResource Backup.Muted}" FontSize="12.5" Margin="0,10,0,0"
                                   Visibility="{Binding CaptureSummary, Converter={StaticResource NonEmptyToVis}}" />

                        <Grid Margin="0,18,0,7" Visibility="{Binding CapturePlanRows.Count, Converter={StaticResource PositiveToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding I18n[migration.capture.plan]}" Style="{StaticResource MigrationMeta}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding CapturePlanRows.Count, Mode=OneWay}" Style="{StaticResource MigrationMeta}" FontWeight="SemiBold" Margin="8,0,8,0" />
                            <Border Grid.Column="2" Height="1" Background="{DynamicResource Backup.Line}" VerticalAlignment="Center" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding CapturePlanRows}" ItemTemplate="{StaticResource PlanRowTemplate}" />

                        <Grid Margin="0,18,0,7" Visibility="{Binding CaptureSkippedRows.Count, Converter={StaticResource PositiveToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding I18n[migration.capture.skipped]}" Style="{StaticResource MigrationMeta}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding CaptureSkippedRows.Count, Mode=OneWay}" Style="{StaticResource MigrationMeta}" FontWeight="SemiBold" Margin="8,0,8,0" />
                            <Border Grid.Column="2" Height="1" Background="{DynamicResource Backup.Line}" VerticalAlignment="Center" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding CaptureSkippedRows}" ItemTemplate="{StaticResource PlanRowTemplate}" />

                        <Grid Margin="0,18,0,7" Visibility="{Binding HasCaptureResults, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding I18n[migration.capture.results]}" Style="{StaticResource MigrationMeta}" FontWeight="SemiBold" />
                            <Border Grid.Column="1" Height="1" Background="{DynamicResource Backup.Line}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding CaptureResultRows}" ItemTemplate="{StaticResource PlanRowTemplate}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="{DynamicResource Backup.Rail.Background}" BorderBrush="{DynamicResource Backup.RailBorder}"
                BorderThickness="1,1,1,0" Padding="16,12">
            <Grid MaxWidth="920" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource MigrationSecondaryButton}" Content="{Binding I18n[migration.button.recommended]}"
                            Command="{Binding SelectRecommendedCommand}" />
                    <Button Style="{StaticResource MigrationSecondaryButton}" Margin="8,0,0,0"
                            Content="{Binding I18n[migration.button.clearOptional]}"
                            Command="{Binding ClearOptionalCommand}" />
                    <Button Style="{StaticResource MigrationSecondaryButton}" Margin="8,0,0,0"
                            Content="{Binding I18n[migration.button.preview]}"
                            Command="{Binding PreviewCommandsCommand}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding SelectedSummary}" Foreground="{DynamicResource Backup.Ink}" FontWeight="Bold" FontSize="13"
                           VerticalAlignment="Center" Margin="16,0" />
                <Button Grid.Column="3" Style="{StaticResource MigrationPrimaryButton}"
                        Content="{Binding I18n[migration.capture.run]}"
                        Command="{Binding RunCaptureCommand}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
