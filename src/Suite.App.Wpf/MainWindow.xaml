<Window x:Class="WindowsCareKit.App.MainWindow"
        x:Name="ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding I18n[app.title]}" Height="720" Width="1100"
        MinHeight="560" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg.Window}"
        Icon="app.ico">

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="D1"
                    Command="{Binding DataContext.SelectNavCommand, ElementName=ShellWindow}"
                    CommandParameter="uninstall" />
        <KeyBinding Modifiers="Control" Key="D2"
                    Command="{Binding DataContext.SelectNavCommand, ElementName=ShellWindow}"
                    CommandParameter="clean" />
        <KeyBinding Modifiers="Control" Key="D3"
                    Command="{Binding DataContext.SelectNavCommand, ElementName=ShellWindow}"
                    CommandParameter="backup" />
        <KeyBinding Modifiers="Control" Key="D4"
                    Command="{Binding DataContext.SelectNavCommand, ElementName=ShellWindow}"
                    CommandParameter="migration" />
        <KeyBinding Modifiers="Control" Key="D5"
                    Command="{Binding DataContext.SelectNavCommand, ElementName=ShellWindow}"
                    CommandParameter="install" />
        <KeyBinding Modifiers="Control" Key="D6"
                    Command="{Binding DataContext.SelectNavCommand, ElementName=ShellWindow}"
                    CommandParameter="restore" />
        <KeyBinding Modifiers="Control" Key="D7"
                    Command="{Binding DataContext.SelectNavCommand, ElementName=ShellWindow}"
                    CommandParameter="settings" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Row 1: quiet brand strip (logo + wordmark + tagline + language selector) -->
        <Border Grid.Row="0" Background="{StaticResource Bg.Panel}" BorderBrush="{StaticResource Border.TopBar}"
                BorderThickness="0,0,0,1" Padding="18,0" Height="44">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="19" Height="19" CornerRadius="6" VerticalAlignment="Center"
                        Margin="0,0,11,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource Brand.Mark.Start}" Offset="0" />
                            <GradientStop Color="{StaticResource Brand.Mark.End}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding I18n[app.title]}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding I18n[app.tagline]}" Style="{StaticResource Faint}"
                               VerticalAlignment="Center" Margin="11,0,0,0" />
                </StackPanel>
                <!-- Language selector: scales to every lang/*.json (English first). -->
                <ComboBox Grid.Column="3" VerticalAlignment="Center" MinWidth="116"
                          VerticalContentAlignment="Center" FontSize="11.5"
                          ToolTip="{Binding I18n[common.language]}"
                          ItemsSource="{Binding I18n.AvailableLanguages}"
                          SelectedValuePath="Code"
                          SelectedValue="{Binding I18n.SelectedCulture, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>

        <!-- Row 2: fixed left task rail plus the selected module content. -->
        <Grid Grid.Row="1" x:Name="ShellBodyGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="TaskRail" Grid.Column="0"
                    Background="{StaticResource Wck.Rail.Background}"
                    BorderBrush="{StaticResource Wck.Rail.Border}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ListBox x:Name="FeatureRailNav" Grid.Row="0"
                             Style="{StaticResource RailNavList}"
                             ItemContainerStyle="{StaticResource RailNavItem}"
                             ItemsSource="{Binding FeatureNav}"
                             SelectedItem="{Binding SelectedFeatureNav}" />

                    <Border x:Name="PromisesFooter" Grid.Row="2" Style="{StaticResource PromisesFooter}">
                        <StackPanel>
                            <TextBlock Text="No ads · no telemetry · no background tasks"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Closes when you close it"
                                       TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                            <TextBlock TextTrimming="CharacterEllipsis" Margin="0,3,0,0">
                                <Run Text="Open source — " />
                                <Hyperlink Command="{Binding SettingsNavItem.Content.OpenExternalLinkCommand}"
                                           CommandParameter="{Binding SettingsNavItem.Content.RepositoryUrl}"
                                           Foreground="{StaticResource Wck.Rail.Accent}">
                                    <Run Text="view the code" />
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="SettingsRailNav" Grid.Row="3"
                             Style="{StaticResource RailNavList}"
                             ItemContainerStyle="{StaticResource RailNavItem}"
                             ItemsSource="{Binding SettingsNav}"
                             SelectedItem="{Binding SelectedSettingsNav}"
                             Margin="0,0,0,8" />
                </Grid>
            </Border>

            <Grid x:Name="ContentColumn" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" x:Name="ModuleHealthNoticeText"
                           Text="{Binding ModuleHealthNotice}"
                           Foreground="{StaticResource Backup.DangerStrong}"
                           FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap"
                           Margin="18,10,18,10"
                           Visibility="{Binding ModuleHealthNotice, Converter={StaticResource NonEmptyToVis}}" />

                <ContentControl x:Name="ModuleContentHost" Grid.Row="1"
                                Content="{Binding CurrentContent}" Margin="0" />
            </Grid>
        </Grid>

        <!-- First-run notice overlay -->
        <Grid Grid.RowSpan="2" Background="{StaticResource Bg.Scrim}"
              Visibility="{Binding ShowFirstRun, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding I18n[firstrun.title]}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding I18n[firstrun.body]}" Style="{StaticResource Muted}" Margin="0,12,0,18" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}"
                            Content="{Binding I18n[firstrun.ok]}" Command="{Binding DismissFirstRunCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
