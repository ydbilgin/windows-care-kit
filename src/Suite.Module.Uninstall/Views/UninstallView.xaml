<UserControl x:Class="WindowsCareKit.Module.Uninstall.Views.UninstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WindowsCareKit.App.Controls;assembly=Suite.App.Abstractions"
             xmlns:mvvm="clr-namespace:WindowsCareKit.App.Mvvm;assembly=Suite.App.Abstractions">
    <!-- M3 (redesign v2): command bar + master grid + a 292 px removal rail, and ONE destructive door.
         The 4-beat wizard is retired: the vendor uninstaller and the leftovers are decided together, in one
         ConfirmGate, before either runs. The rail PREVIEWS the plan; the veto checkboxes live in the gate,
         where the approval happens. Scope is an inventory filter (All / Desktop / Microsoft Store) — an
         inspectable behaviour, not a mode name — and the leftover scan is ONE action, because the three
         depth modes ran the same scan (A-M3-1, decision §2.5-10). -->
    <UserControl.Resources>
        <mvvm:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <mvvm:ZeroToVisibleConverter x:Key="ZeroToVis" />
        <mvvm:PositiveToVisibleConverter x:Key="PositiveToVis" />
        <mvvm:NonEmptyToVisibleConverter x:Key="NonEmptyToVis" />
        <mvvm:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style x:Key="UninstallMeta" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Backup.Faint}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="RailSectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Backup.Faint}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>

        <Style x:Key="RailFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Backup.Faint}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="RailFieldValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Backup.Ink}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,1,0,8" />
        </Style>

        <!-- Column header: quiet, faint, no chrome. -->
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Backup.Chrome}" />
            <Setter Property="Foreground" Value="{DynamicResource Backup.Faint}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="BorderBrush" Value="{DynamicResource Backup.Line}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <Style x:Key="GridHeaderRight" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>

        <!-- Row container: fixed ~46px height, hover/selected fills from the emerald evidence-row palette. -->
        <Style x:Key="GridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Backup.Ink}" />
            <Setter Property="Height" Value="46" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Backup.CardHi}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Backup.EmWash}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Backup.Ink}" />
            <Setter Property="Background" Value="{DynamicResource Backup.Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Backup.LineStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Backup.CardHi}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Backup.Faint}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="{DynamicResource Opacity.Disabled.Button}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The one irreversible action on this screen — loud red, never emerald. It only OPENS the gate;
             the removal itself still needs the typed confirm word. -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="{DynamicResource Backup.DangerText}" />
            <Setter Property="Background" Value="{DynamicResource Backup.Danger}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Backup.DangerDeep}" />
        </Style>

        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Backup.Ink}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Right-aligned, tabular-figure cell for Size / Installed. -->
        <Style x:Key="NumCell" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Backup.Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        </Style>

        <Style x:Key="SearchTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="{DynamicResource Backup.Card}" />
            <Setter Property="Foreground" Value="{DynamicResource Backup.Ink}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Backup.LineStrong}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                                <TextBlock x:Name="Watermark"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="{DynamicResource Backup.Faint}"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding Text.Length, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ZeroToVis}}"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value="" />
                                    <Condition Property="IsKeyboardFocusWithin" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Watermark" Property="Opacity" Value="0.45" />
                            </MultiTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Backup.Faint}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The scope segments. A ListBox rather than three buttons: the selection is single by
             construction, and the arrow-key / type-to-search list flow the redesign guardrail preserves
             comes for free (decision §2.5-13). -->
        <Style x:Key="ScopeSegment" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Backup.Muted}" />
            <Setter Property="Background" Value="{DynamicResource Backup.Card}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource Backup.Line}" BorderThickness="0,0,1,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Backup.CardHi}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Backup.EmWash}" />
                                <Setter Property="Foreground" Value="{DynamicResource Backup.Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The rail's preview row. It carries NO checkbox: the rail previews the plan, and the veto lives in
             the gate where the approval is given, so there is exactly one place to change the selection. -->
        <DataTemplate x:Key="RailPlanRowTemplate">
            <Border Background="{DynamicResource Backup.Row.Background}" BorderBrush="{DynamicResource Backup.Line}"
                    BorderThickness="1" CornerRadius="8" Padding="9,7" Margin="0,0,0,5">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <controls:RiskChip Grid.Column="0" Risk="{Binding Risk}" IsBlocked="{Binding IsSkipped}"
                                           Text="{Binding RiskText}"
                                           VerticalAlignment="Top" Margin="0,1,8,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{DynamicResource Backup.Ink}"
                                   FontFamily="{DynamicResource Wck.Mono}"
                                   FontSize="11.5" TextWrapping="Wrap" />
                    </Grid>
                    <ContentControl Visibility="{Binding DataContext.TechnicalDetails, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource UninstallMeta}" Margin="0,3,0,0"
                                   Visibility="{Binding Detail, Converter={StaticResource NonEmptyToVis}}" />
                    </ContentControl>
                    <controls:UndoLine Recovery="{Binding Recovery}" Text="{Binding Undo}"
                                       HorizontalAlignment="Left" Margin="0,4,0,0"
                                       Visibility="{Binding Undo, Converter={StaticResource NonEmptyToVis}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,14,24,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Row 0: header — H1 + machine-state pill + subtitle + inventory health note ===== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="UninstallTitleText" Text="{Binding I18n[uninstall.title]}"
                           Foreground="{DynamicResource Backup.Ink}"
                           FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <controls:StatePill Grid.Column="1" x:Name="UninstallStatePill"
                                    State="{Binding State}" Text="{Binding StateText}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
            <TextBlock Text="{Binding I18n[uninstall.subtitle]}" Foreground="{DynamicResource Backup.Muted}"
                       FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0" />
            <!-- "Some installed apps could not be read" is partial data — the amber attention family, not
                 red. A degraded inventory is the one thing on this screen a user must not mistake for a
                 complete one (A-M3-6). -->
            <controls:HealthChip x:Name="UninstallInventoryNoteText" Text="{Binding InventoryNotice}"
                                 HorizontalAlignment="Stretch" Margin="0,9,0,0"
                                 Visibility="{Binding HasInventoryNotice, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- ===== Row 1: command bar — search · scope · sort · Refresh · Technical details ===== -->
        <Grid Grid.Row="1" x:Name="UninstallCommandBar" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Search: refreshes the ICollectionView filter only (never refills the source). -->
            <!-- Stretch up to 420, but never below 170: the watermark is a whole phrase, and a box narrower
                 than the phrase would draw it outside its own content rect rather than eliding it. -->
            <TextBox Grid.Column="0" MaxWidth="420" MinWidth="170" HorizontalAlignment="Stretch"
                     Tag="{Binding I18n[common.search]}" ToolTip="{Binding I18n[common.search]}"
                     Style="{StaticResource SearchTextBox}"
                     VerticalContentAlignment="Center"
                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" />

            <Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="7" BorderThickness="1"
                    BorderBrush="{DynamicResource Backup.Line}" ClipToBounds="True" VerticalAlignment="Center">
                <ListBox x:Name="ScopeSegments" SelectedIndex="{Binding ScopeIndex, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource ScopeSegment}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBoxItem Content="{Binding I18n[uninstall.scope.all]}" />
                    <ListBoxItem Content="{Binding I18n[uninstall.scope.desktop]}" />
                    <ListBoxItem Content="{Binding I18n[uninstall.scope.store]}" />
                </ListBox>
            </Border>

            <TextBlock Grid.Column="2" Text="{Binding I18n[uninstall.sort]}" Foreground="{DynamicResource Backup.Faint}"
                       FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0" />

            <Button Grid.Column="3" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}"
                    Content="{Binding I18n[common.refresh]}" Command="{Binding RefreshCommand}" />

            <CheckBox Grid.Column="4" x:Name="TechnicalDetailsToggle" Margin="12,0,0,0" VerticalAlignment="Center"
                      IsChecked="{Binding TechnicalDetails, Mode=TwoWay}"
                      Foreground="{DynamicResource Backup.Muted}">
                <TextBlock Text="{Binding I18n[uninstall.tech.details]}" Foreground="{DynamicResource Backup.Muted}"
                           FontSize="11.5" />
            </CheckBox>
        </Grid>

        <!-- ===== Row 2: master grid + the 292 px removal rail ===== -->
        <Grid Grid.Row="2" x:Name="UninstallBody">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="292" />
            </Grid.ColumnDefinitions>

            <!-- ===== The single virtualized DataGrid (desktop + Store, flat, name-sorted) ===== -->
            <Border Grid.Column="0" x:Name="MasterColumn" Background="{DynamicResource Backup.Card}"
                    BorderBrush="{DynamicResource Backup.Line}"
                    BorderThickness="1" CornerRadius="10">
                <Grid>
                    <!-- L-5: at the narrowest width this module ever receives (780 px of content, of which
                         292 belong to the rail) the fixed columns are wider than the master card. The honest
                         answer is to let the GRID scroll inside its own bordered container — never to shrink
                         the type, and never to let a column header draw outside its own cell, which is what
                         a Disabled horizontal scrollbar plus a collapsed star column produced. -->
                    <DataGrid x:Name="AppsGrid"
                              ItemsSource="{Binding AppsView}"
                              SelectedItem="{Binding SelectedRow}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              CanUserReorderColumns="False" CanUserResizeRows="False"
                              IsReadOnly="True" SelectionMode="Single"
                              Background="Transparent" BorderThickness="0" RowBackground="Transparent"
                              Foreground="{DynamicResource Backup.Ink}"
                              ColumnHeaderStyle="{StaticResource GridHeader}"
                              RowStyle="{StaticResource GridRow}"
                              CellStyle="{StaticResource GridCell}"
                              RowHeight="46"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True">
                        <DataGrid.Columns>
                            <!-- 38, not 28: the cell style pads 10 px on each side and the glyph is typeset at
                                 15 px, so a 28 px column measured the glyph 3.5 px OUTSIDE its own cell on
                                 both edges. Widening the column is the fix; typesetting the glyph smaller
                                 would have hidden the overflow behind a smaller font. -->
                            <DataGridTemplateColumn Width="38" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IconGlyph}"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="15" Foreground="{DynamicResource Backup.Muted}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="{Binding Data.I18n[uninstall.col.name], Source={StaticResource Proxy}}"
                                                    Width="*" MinWidth="180" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource Backup.Ink}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Publisher}" Foreground="{DynamicResource Backup.Faint}"
                                                       FontSize="10.5" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn x:Name="PublisherColumn"
                                                Header="{Binding Data.I18n[uninstall.col.publisher], Source={StaticResource Proxy}}"
                                                Binding="{Binding Publisher}" Width="120" CanUserSort="False">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Backup.Muted}" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="SizeColumn"
                                                Header="{Binding Data.I18n[uninstall.col.size], Source={StaticResource Proxy}}"
                                                Binding="{Binding SizeDisplay}" Width="72" CanUserSort="False"
                                                HeaderStyle="{StaticResource GridHeaderRight}"
                                                ElementStyle="{StaticResource NumCell}" />

                            <DataGridTextColumn x:Name="InstalledColumn"
                                                Header="{Binding Data.I18n[uninstall.col.installed], Source={StaticResource Proxy}}"
                                                Binding="{Binding InstallDateDisplay}" Width="92" CanUserSort="False"
                                                HeaderStyle="{StaticResource GridHeaderRight}"
                                                ElementStyle="{StaticResource NumCell}" />

                            <DataGridTextColumn x:Name="VersionColumn"
                                                Header="{Binding Data.I18n[uninstall.col.version], Source={StaticResource Proxy}}"
                                                Binding="{Binding Version}" Width="72" CanUserSort="False">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Backup.Muted}" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Status: a chip resolved from the shared vocabulary, so it follows the theme.
                                 It used to paint two frozen hexes handed over by the row projection. -->
                            <DataGridTemplateColumn Header="{Binding Data.I18n[uninstall.col.status], Source={StaticResource Proxy}}"
                                                    Width="110" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <controls:FamilyChip Family="{Binding BadgeFamily}" Glyph="{Binding BadgeGlyph}"
                                                             Text="{Binding BadgeText}" FontSize="11"
                                                             VerticalAlignment="Center"
                                                             Visibility="{Binding BadgeText, Converter={StaticResource NonEmptyToVis}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Loading overlay -->
                    <Border Background="{DynamicResource Bg.Scrim.Loading}" CornerRadius="10"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding I18n[uninstall.loading]}" Foreground="{DynamicResource Backup.Muted}"
                                   FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Border>

            <!-- ===== The removal rail — 292 px: what removal will do, and the one door that does it ===== -->
            <Border Grid.Column="2" x:Name="RemovalRail" Background="{DynamicResource Wck.Rail.Background}"
                    BorderBrush="{DynamicResource Wck.Rail.Border}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <TextBlock Text="{Binding I18n[uninstall.selectPrompt]}" Foreground="{DynamicResource Backup.Muted}"
                               FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="240"
                               Margin="16" TextAlignment="Center" TextWrapping="Wrap"
                               Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}" />

                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" Margin="13">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer x:Name="RailScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="{Binding DetailTitle}" Foreground="{DynamicResource Backup.Ink}"
                                           FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10" />

                                <TextBlock Text="{Binding I18n[uninstall.detail.publisher]}" Style="{StaticResource RailFieldLabel}" />
                                <TextBlock Text="{Binding DetailPublisher}" Style="{StaticResource RailFieldValue}" />

                                <TextBlock Text="{Binding I18n[uninstall.detail.version]}" Style="{StaticResource RailFieldLabel}" />
                                <TextBlock Text="{Binding DetailVersion}" Style="{StaticResource RailFieldValue}" />

                                <StackPanel Visibility="{Binding HasDetailLocation, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding I18n[uninstall.detail.location]}" Style="{StaticResource RailFieldLabel}" />
                                    <Border Background="{DynamicResource Backup.PathBg}" BorderBrush="{DynamicResource Backup.Line}"
                                            BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,3,0,6">
                                        <TextBlock Text="{Binding DetailLocation}" Foreground="{DynamicResource Backup.Muted}"
                                                   FontFamily="{DynamicResource Wck.Mono}"
                                                   FontSize="11" TextWrapping="Wrap" />
                                    </Border>
                                    <Button HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"
                                            Padding="10,4" FontSize="11.5" FontWeight="Normal"
                                            Content="{Binding I18n[uninstall.detail.openLocation]}"
                                            Command="{Binding OpenLocationCommand}" />
                                </StackPanel>

                                <!-- ===== What removal will do ===== -->
                                <StackPanel x:Name="WhatRemovalDoesSection"
                                            Visibility="{Binding HasDesktopSelection, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding I18n[uninstall.removal.what]}" Style="{StaticResource RailSectionLabel}" />

                                    <StackPanel Visibility="{Binding HasVendorCommand, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding I18n[uninstall.removal.runline]}"
                                                   Foreground="{DynamicResource Backup.Muted}" FontSize="11.5"
                                                   TextWrapping="Wrap" />
                                        <!-- The LITERAL command, glyph for glyph, from the staged action's typed
                                             fields. Mono, wrapping, never trimmed: a path the user cannot read in
                                             full is a path they cannot check. -->
                                        <TextBlock x:Name="VendorCommandText" Text="{Binding VendorCommandLine}"
                                                   Foreground="{DynamicResource Backup.Muted}"
                                                   FontFamily="{DynamicResource Wck.Mono}" FontSize="11"
                                                   TextWrapping="Wrap" TextTrimming="None" Margin="0,3,0,0" />
                                    </StackPanel>

                                    <controls:HealthChip x:Name="VendorUnavailableNote"
                                                         Text="{Binding I18n[uninstall.removal.official.unavailable]}"
                                                         HorizontalAlignment="Stretch"
                                                         Visibility="{Binding VendorCommandUnavailable, Converter={StaticResource BoolToVis}}" />

                                    <!-- The restore-point preflight. Neutral info: it states the state of the
                                         world, it does not caption anything as safe. -->
                                    <Border x:Name="RestorePointPreflight" Background="{DynamicResource Wck.Info.Wash}"
                                            BorderBrush="{DynamicResource Wck.Info.Border}" BorderThickness="1"
                                            CornerRadius="7" Padding="8,6" Margin="0,8,0,0"
                                            Visibility="{Binding RestorePointAvailable, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <CheckBox x:Name="RestorePointToggle" IsChecked="{Binding RestorePointEnabled, Mode=TwoWay}"
                                                      Foreground="{DynamicResource Wck.Info.Fg}">
                                                <TextBlock Text="{Binding I18n[uninstall.removal.restorePoint.title]}"
                                                           Foreground="{DynamicResource Wck.Info.Fg}"
                                                           FontSize="11.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </CheckBox>
                                            <TextBlock x:Name="RestorePointPreflightText"
                                                       Text="{Binding I18n[uninstall.removal.restorePoint.preflight]}"
                                                       Foreground="{DynamicResource Wck.Info.Fg}" FontSize="11"
                                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <controls:HealthChip x:Name="RestorePointUnavailableNote"
                                                         Text="{Binding I18n[uninstall.removal.restorePoint.unavailable]}"
                                                         HorizontalAlignment="Stretch" Margin="0,8,0,0"
                                                         Visibility="{Binding RestorePointAvailable, Converter={StaticResource InverseBoolToVis}}" />

                                    <ContentControl Visibility="{Binding TechnicalDetails, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding I18n[uninstall.removal.honest]}"
                                                   Style="{StaticResource UninstallMeta}" Margin="0,8,0,0" />
                                    </ContentControl>

                                    <!-- ===== Likely leftovers — ONE scan action, no depth modes ===== -->
                                    <Grid Margin="0,12,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding I18n[uninstall.removal.leftovers]}"
                                                   Style="{StaticResource RailSectionLabel}" Margin="0,0,6,0"
                                                   VerticalAlignment="Center" />
                                        <Button Grid.Column="1" x:Name="ScanLeftoversButton"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="10,4" FontSize="11.5"
                                                Content="{Binding I18n[uninstall.removal.scan]}"
                                                Command="{Binding ScanLeftoversCommand}" />
                                    </Grid>

                                    <TextBlock Text="{Binding I18n[uninstall.removal.scanning]}"
                                               Style="{StaticResource UninstallMeta}" Margin="0,0,0,6"
                                               Visibility="{Binding IsScanningLeftovers, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock x:Name="NotScannedText" Text="{Binding I18n[uninstall.removal.notScanned]}"
                                               Style="{StaticResource UninstallMeta}" Margin="0,0,0,6"
                                               Visibility="{Binding HasScanned, Converter={StaticResource InverseBoolToVis}}" />

                                    <ItemsControl x:Name="LeftoverRowsHost" ItemsSource="{Binding LeftoverRows}"
                                                  ItemTemplate="{StaticResource RailPlanRowTemplate}" />

                                    <!-- What the classifier and the gate refused stays INLINE with what remains,
                                         with its reason — exclusion is visible, never silent (decision §2.5-9). -->
                                    <TextBlock Text="{Binding I18n[uninstall.removal.skippedTitle]}"
                                               Foreground="{DynamicResource Backup.Muted}"
                                               FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,5" TextWrapping="Wrap"
                                               Visibility="{Binding LeftoverSkipped.Count, Converter={StaticResource PositiveToVis}}" />
                                    <ItemsControl x:Name="LeftoverSkippedHost" ItemsSource="{Binding LeftoverSkipped}"
                                                  ItemTemplate="{StaticResource RailPlanRowTemplate}" />

                                    <TextBlock Text="{Binding I18n[uninstall.removal.none]}" Margin="0,0,0,6">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource UninstallMeta}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding HasScanned}" Value="True" />
                                                            <Condition Binding="{Binding LeftoverRows.Count}" Value="0" />
                                                            <Condition Binding="{Binding LeftoverSkipped.Count}" Value="0" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Fail-loud: the ProgramOwned-only guard fired. Nothing was staged. -->
                                <Border x:Name="BuildErrorBanner" Background="{DynamicResource Backup.Row.Danger}"
                                        BorderBrush="{DynamicResource Backup.DangerBorder}" BorderThickness="1"
                                        CornerRadius="8" Padding="9,7" Margin="0,10,0,0"
                                        Visibility="{Binding HasBuildError, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding BuildError}" Foreground="{DynamicResource Backup.DangerStrong}"
                                               FontSize="11.5" TextWrapping="Wrap" />
                                </Border>

                                <!-- The run receipt: done / skipped / failed, with each row's own outcome. -->
                                <StackPanel x:Name="ResultSection" Margin="0,12,0,0"
                                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding I18n[uninstall.result.title]}" Style="{StaticResource RailSectionLabel}"
                                               Margin="0,0,0,4" />
                                    <TextBlock x:Name="ResultSummaryText" Text="{Binding ResultSummary}"
                                               Foreground="{DynamicResource Backup.Ink}" FontSize="12.5"
                                               TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding ProtectedNote}" Style="{StaticResource UninstallMeta}"
                                               Margin="0,0,0,6"
                                               Visibility="{Binding HasProtectedNote, Converter={StaticResource BoolToVis}}" />
                                    <ItemsControl x:Name="ExecutionResultsHost" ItemsSource="{Binding ExecutionResults}"
                                                  ItemTemplate="{StaticResource RailPlanRowTemplate}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- The ONE destructive door. It opens the gate; nothing is removed until the gate's
                             typed confirm word unlocks Approve. -->
                        <Button Grid.Row="1" x:Name="RemoveButton" Style="{StaticResource DangerButton}"
                                Margin="0,12,0,0" HorizontalAlignment="Stretch" Padding="12,9"
                                Content="{Binding RemoveButtonText}"
                                Command="{Binding UninstallSelectedCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- The one approval door — the reusable ConfirmGate (UI decision §B2). -->
        <controls:ConfirmGate Grid.RowSpan="3" DataContext="{Binding Gate}" />
    </Grid>
</UserControl>
